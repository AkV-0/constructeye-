{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter: Web (Chrome)",
            "cwd": "mobile_app",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": ["--web-port=8080"]
        },
        {
            "name": "Flutter: Mobile (Android)",
            "cwd": "mobile_app",
            "request": "launch",
            "type": "dart",
            "deviceId": "android"
        },
        {
            "name": "Flutter: Mobile (iOS)",
            "cwd": "mobile_app",
            "request": "launch",
            "type": "dart",
            "deviceId": "ios"
        },
        {
            "name": "mobile_app (profile mode)",
            "cwd": "mobile_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "mobile_app (release mode)",
            "cwd": "mobile_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ],
    "compounds": [
        {
            "name": "Flutter: Web + Mobile",
            "configurations": ["Flutter: Web (Chrome)", "Flutter: Mobile (Android)"]
        }
    ]
}